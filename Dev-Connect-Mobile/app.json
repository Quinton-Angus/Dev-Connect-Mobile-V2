      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080808",
          "image": "./src/assets/splash_screen_logo.png",
          "imageWidth": "50"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "45207ebb-21b1-412f-a5d3-418939333051"
