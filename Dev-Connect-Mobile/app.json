{
  "expo": {
    "name": "Dev Connect",
    "slug": "Dev-Connect",
    "scheme": "devconnect",
    "version": "1.2.5",
    "orientation": "portrait",
    "icon": "./src/assets/app_icon.png",
    "backgroundColor": "#080808",
    "android": {
      "package": "com.quintondevstudios.devconnect"
    },
    "androidStatusBar": {
      "backgroundColor": "#080808",
